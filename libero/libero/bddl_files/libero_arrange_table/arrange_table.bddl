(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Arrange Table)
    (:regions
      (plate_left_region
          (:target living_room_table)
          (:ranges (
              (-0.025 -0.325 0.025 -0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_right_region
          (:target living_room_table)
          (:ranges (
              (-0.025 0.275 0.025 0.325)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.225 -0.025 -0.175 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.125 -0.175 -0.075 -0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.125 0.125 -0.075 0.175)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_init_region
          (:target living_room_table)
          (:ranges (
              (0.075 -0.025 0.125 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    white_yellow_mug_1 - white_yellow_mug
    butter_1 - butter
    plate_1 plate_2 - plate
    basket_1 - basket
  )

  (:obj_of_interest
    porcelain_mug_1
    white_yellow_mug_1
    butter_1
    plate_1
    plate_2
    basket_1
  )

  (:init
    (On plate_1 living_room_table_plate_left_region)
    (On plate_2 living_room_table_plate_right_region)
    (On basket_1 living_room_table_basket_init_region)
    (On porcelain_mug_1 living_room_table_porcelain_mug_init_region)
    (On white_yellow_mug_1 living_room_table_white_yellow_mug_init_region)
    (On butter_1 living_room_table_butter_init_region)
  )

  (:goal
    (And
      (On porcelain_mug_1 plate_1)
      (On white_yellow_mug_1 plate_2)
      (In butter_1 basket_1_contain_region)
    )
  )
)
